---
/**
 * ExperienceSection Component — Professional Experience Timeline
 * Frame 4: Aligned with Work and About sections
 */
import site from '../data/site.json';
import '../styles/experience.css';
---

<h2 class="experience-heading" id="experience">{site.experienceSection.title || 'Experience'}</h2>

<section class="experience-section" aria-label="Professional Experience">
	{site.experienceSection.items.map((item) => (
		<article class="experience-item">
			<div class="experience-header">
				<span class="experience-num">{item.id}.</span>
				<span class="experience-role-period">{item.role} · {item.period}</span>
			</div>
			<p class="experience-desc">{item.description}</p>
		</article>
	))}
</section>

<div class="experience-divider" aria-hidden="true"></div>

<script is:inline>
	function syncExperienceDivider() {
		const divider = document.querySelector('.experience-divider');
		const section = document.querySelector('.experience-section');
		const heading = document.querySelector('.experience-heading');
		if (window.innerWidth <= 768) {
			if (divider) { divider.style.left = ''; divider.style.right = ''; }
			if (section) { section.style.left = ''; section.style.right = ''; }
			if (heading) heading.style.left = '';
			return;
		}

		const themeBtn = document.querySelector('.theme-btn');
		const logo = document.querySelector('.brand-logo');
		const canvas = document.querySelector('.page-canvas');
		if (!canvas) return;

		const canvasRect = canvas.getBoundingClientRect();
		if (themeBtn) {
			const themeRect = themeBtn.getBoundingClientRect();
			const rightOffset = Math.max(0, canvasRect.right - themeRect.right);
			if (divider) divider.style.right = `${rightOffset}px`;
			if (section) section.style.right = `${rightOffset}px`;
		}
		if (logo) {
			const logoRect = logo.getBoundingClientRect();
			const leftOffset = Math.max(0, logoRect.left - canvasRect.left);
			if (divider) divider.style.left = `${leftOffset}px`;
			if (heading) heading.style.left = `${leftOffset}px`;
		}
	}

	window.addEventListener('resize', syncExperienceDivider);
	window.addEventListener('load', syncExperienceDivider);
	document.addEventListener('DOMContentLoaded', syncExperienceDivider);
	syncExperienceDivider();
</script>
