---
/**
 * WorkSection Component — Work Section with Intro and Accordion List
 * Frame 3: Equal visuals and alignment with About section
 */
import site from '../data/site.json';
import '../styles/work.css';
---

<h2 class="work-heading">{site.workSection.title || 'Work'}</h2>

<section class="work-section" aria-label="Work and Projects">
	<p class="work-intro">
		{site.workSection.intro}
	</p>

	<div class="work-accordion-list" role="list">
		{site.workSection.categories.map((cat) => (
			<div class="work-accordion-item" role="listitem" tabindex="0">
				<div class="work-item-text">
					<span class="work-item-num">{cat.id}.</span>
					<span class="work-item-title">{cat.name}</span>
				</div>
				<span class="work-item-arrow" aria-hidden="true">
					<svg width="18" height="11" viewBox="0 0 18 11" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M1 1L9 9L17 1" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</span>
			</div>
		))}
	</div>
</section>

<div class="work-divider" aria-hidden="true"></div>

<script is:inline>
	function syncWorkDivider() {
		const themeBtn = document.querySelector('.theme-btn');
		const logo = document.querySelector('.brand-logo');
		const divider = document.querySelector('.work-divider');
		const section = document.querySelector('.work-section');
		const heading = document.querySelector('.work-heading');
		const canvas = document.querySelector('.page-canvas');
		if (!canvas) return;

		const canvasRect = canvas.getBoundingClientRect();
		if (themeBtn) {
			const themeRect = themeBtn.getBoundingClientRect();
			const rightOffset = Math.max(0, canvasRect.right - themeRect.right);
			if (divider) divider.style.right = `${rightOffset}px`;
			if (section) section.style.right = `${rightOffset}px`;
		}
		if (logo) {
			const logoRect = logo.getBoundingClientRect();
			const leftOffset = Math.max(0, logoRect.left - canvasRect.left);
			if (divider) divider.style.left = `${leftOffset}px`;
			if (heading) heading.style.left = `${leftOffset}px`;
		}
	}

	window.addEventListener('resize', syncWorkDivider);
	window.addEventListener('load', syncWorkDivider);
	document.addEventListener('DOMContentLoaded', syncWorkDivider);
	syncWorkDivider();
</script>
