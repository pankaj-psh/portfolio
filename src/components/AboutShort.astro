---
/**
 * AboutShort Component — Short Bio Paragraphs and Aligned Separator
 */
import site from '../data/site.json';
import '../styles/about.css';
---

<div class="about-frame" id="about">
	<h2 class="about-heading">{site.aboutShort.title || 'About'}</h2>

	<section class="about-section" aria-label="About Pankaj Sharma">
		<p class="about-text">
			{site.aboutShort.p1}
		</p>
		<p class="about-text">
			{site.aboutShort.p2}
		</p>
	</section>

	<div class="about-divider" aria-hidden="true"></div>
</div>

<script is:inline>
	function syncAboutDivider() {
		if (window.innerWidth <= 768) return;

		const divider = document.querySelector('.about-divider');
		const section = document.querySelector('.about-section');
		const heading = document.querySelector('.about-heading');
		const themeBtn = document.querySelector('.theme-btn');
		const logo = document.querySelector('.brand-logo');
		const canvas = document.querySelector('.page-canvas');
		if (!canvas) return;

		const canvasRect = canvas.getBoundingClientRect();
		if (themeBtn) {
			const themeRect = themeBtn.getBoundingClientRect();
			const rightOffset = Math.max(0, canvasRect.right - themeRect.right);
			if (divider) divider.style.right = `${rightOffset}px`;
			if (section) section.style.right = `${rightOffset}px`;
		}
		if (logo) {
			const logoRect = logo.getBoundingClientRect();
			const leftOffset = Math.max(0, logoRect.left - canvasRect.left);
			if (divider) divider.style.left = `${leftOffset}px`;
			if (heading) heading.style.left = `${leftOffset}px`;
		}
	}

	let lastAboutWidth = window.innerWidth;
	window.addEventListener('resize', () => {
		if (window.innerWidth <= 768 && lastAboutWidth <= 768) return;
		if (window.innerWidth === lastAboutWidth) return;
		lastAboutWidth = window.innerWidth;
		syncAboutDivider();
	}, { passive: true });
	window.addEventListener('load', syncAboutDivider);
	document.addEventListener('DOMContentLoaded', syncAboutDivider);
	syncAboutDivider();
</script>
