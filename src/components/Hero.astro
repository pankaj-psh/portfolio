---
/**
 * Hero Component — Greeting, Bio, Live IST Clock, and Separator
 */
import { Image } from 'astro:assets';
import indiaFlag from '../assets/icon/india.svg';
import site from '../data/site.json';
import '../styles/hero.css';

const bioParts = site.hero.bio.split('🇮🇳');
---

<div class="hero-frame">
	<section class="hero-section" aria-label="Introduction">
		<div class="hero-content">
			<h1 class="hero-headline">
				{site.hero.greeting}<br />{site.hero.name}
			</h1>
			<p class="hero-bio">
				{bioParts.length > 1 ? (
					<>
						{bioParts[0].trimEnd()}&nbsp;<Image src={indiaFlag} alt="India Flag" class="hero-flag" width={22} height={22} loading="eager" />{bioParts[1]}
					</>
				) : (
					site.hero.bio
				)}
			</p>
		</div>
		<div class="hero-time-wrap">
			<time id="ist-clock" class="hero-time" aria-label="Current time in Indian Standard Time">--:--:-- IST</time>
		</div>
	</section>

	<div class="hero-divider" aria-hidden="true"></div>
</div>

<script is:inline>
	function updateIstClock() {
		const clock = document.getElementById('ist-clock');
		if (!clock) return;
		const now = new Date();
		const formatted = now.toLocaleTimeString('en-GB', {
			timeZone: 'Asia/Kolkata',
			hour12: false,
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
		});
		clock.textContent = `${formatted} IST`;
	}
	updateIstClock();
	setInterval(updateIstClock, 1000);

	function syncDivider() {
		const divider = document.querySelector('.hero-divider');
		const heroSection = document.querySelector('.hero-section');
		if (window.innerWidth <= 768) {
			if (divider) {
				divider.style.left = '';
				divider.style.right = '';
			}
			if (heroSection) heroSection.style.left = '';
			return;
		}

		const themeBtn = document.querySelector('.theme-btn');
		const logo = document.querySelector('.brand-logo');
		const canvas = document.querySelector('.page-canvas');
		if (!canvas) return;

		const canvasRect = canvas.getBoundingClientRect();
		if (themeBtn && divider) {
			const themeRect = themeBtn.getBoundingClientRect();
			const rightOffset = Math.max(0, canvasRect.right - themeRect.right);
			divider.style.right = `${rightOffset}px`;
		}
		if (logo) {
			const logoRect = logo.getBoundingClientRect();
			const leftOffset = Math.max(0, logoRect.left - canvasRect.left);
			if (divider) divider.style.left = `${leftOffset}px`;
			if (heroSection) {
				heroSection.style.left = `${leftOffset}px`;
			}
		}
	}

	window.addEventListener('resize', syncDivider);
	window.addEventListener('load', syncDivider);
	document.addEventListener('DOMContentLoaded', syncDivider);
	syncDivider();
</script>
