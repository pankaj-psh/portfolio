---
/**
 * Main Home Page
 * Frame: 1440px x 6144px (matching Figma Desktop - 1)
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutShort from '../components/AboutShort.astro';
---

<Layout>
	<main class="page-canvas">
		<Header />
		<Hero />
		<AboutShort />
		<!-- Future sections will mount here -->
	</main>
</Layout>

<style>
	.page-canvas {
		width: 100%;
		max-width: 1440px;
		min-height: 6144px;
		margin: 0 auto;
		position: relative;
		box-sizing: border-box;
		background: transparent !important;
	}
</style>
