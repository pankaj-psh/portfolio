---
/**
 * Main Home Page
 * Frame: 1440px x 6144px (matching Figma Desktop - 1)
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutShort from '../components/AboutShort.astro';
import WorkSection from '../components/WorkSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ConnectSection from '../components/ConnectSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<main class="page-canvas">
		<Header />
		<Hero />
		<AboutShort />
		<WorkSection />
		<ExperienceSection />
		<ConnectSection />
		<Footer />
	</main>
</Layout>

<style>
	.page-canvas {
		width: 100%;
		max-width: 1440px;
		min-height: 4370px;
		margin: 0 auto;
		position: relative;
		box-sizing: border-box;
		background: transparent !important;
	}

	@media (max-width: 1440px) {
		.page-canvas {
			min-height: clamp(3000px, 303.4vw, 4370px);
		}
	}

	@media (max-width: 640px) {
		.page-canvas {
			min-height: calc(500vh + 160px);
			min-height: calc(500dvh + 160px);
		}
	}
</style>
