---
/**
 * Root layout — Single entry for all pages.
 * Includes meta title, favicons, global styles, and right-side scroll dots indicator.
 */
import '../styles/global.css';
import site from '../data/site.json';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon-dark.svg`} media="(prefers-color-scheme: dark)" />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<!-- Preload primary critical fonts locally to eliminate FOUT -->
		<link rel="preload" href={`${baseUrl}fonts/cormorant-garamond-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${baseUrl}fonts/courier-prime-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${baseUrl}fonts/jost-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
		<title>{site.meta.title}</title>
		<!-- Theme initialization (prevents FOUC on reload) -->
		<script is:inline>
			(function () {
				try {
					var raw = localStorage.getItem('themeLevel');
					var level = raw !== null ? parseInt(raw, 10) : 39;
					if (isNaN(level) || level < 0) level = 0;
					if (level > 39) level = 39;
					var themes = ['dark', 'dim', 'gray', 'soft', 'light'];
					var themeIdx = Math.min(4, Math.floor(level / 8));
					document.documentElement.setAttribute('data-theme', themes[themeIdx]);
					document.documentElement.setAttribute('data-theme-level', String(level));
				} catch (e) {}
			})();
		</script>
	</head>

	<body>
		<slot />

		<!-- Custom scroll indicator -->
		<nav id="scroll-dots" aria-label="Page scroll position">
			{Array.from({ length: 60 }).map((_, i) => (
				<button class="scroll-dot" data-index={i} aria-label={`Scroll to position ${i + 1}`} />
			))}
		</nav>
	</body>
</html>

<style>
	#scroll-dots {
		position: fixed;
		right: 6px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		z-index: 1000;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
	}

	.scroll-dot {
		width: 4px;
		height: 4px;
		border-radius: 100%;
		background-color: gray;
		border: none;
		padding: 0;
		cursor: pointer;
		display: block;
		flex-shrink: 0;
	}

	.scroll-dot.active {
		background-color: #f59794;
	}

	@media (max-width: 768px) {
		#scroll-dots {
			display: none !important;
		}
	}
</style>

<script is:inline>
	const dots = document.querySelectorAll('.scroll-dot');
	const total = dots.length;

	let targetIndex = 0;
	let currentIndex = 0;
	let rafId = null;

	function getTargetIndex() {
		const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
		const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
		return progress * (total - 1);
	}

	function setActive(index) {
		const rounded = Math.round(index);
		dots.forEach((dot, i) => {
			const isActive = i === rounded;
			const dist = Math.abs(i - index);
			const xOffset = Math.min(0, dist * dist * 1.5 - 4);
			const scale = isActive ? 2.2 : 1;
			dot.style.transform = `translateX(${xOffset}px) scale(${scale})`;
			dot.classList.toggle('active', isActive);
		});
	}

	function animate() {
		const diff = targetIndex - currentIndex;
		if (Math.abs(diff) < 0.01) {
			currentIndex = targetIndex;
			setActive(currentIndex);
			rafId = null;
			return;
		}
		currentIndex += diff * 0.12;
		setActive(currentIndex);
		rafId = requestAnimationFrame(animate);
	}

	window.addEventListener('scroll', () => {
		if (window.innerWidth <= 768) return;
		targetIndex = getTargetIndex();
		if (!rafId) rafId = requestAnimationFrame(animate);
	}, { passive: true });

	dots.forEach((dot, i) => {
		dot.addEventListener('click', () => {
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const scrollTo = (i / (total - 1)) * maxScroll;
			window.scrollTo({ top: scrollTo, behavior: 'smooth' });
		});
	});

	if (window.innerWidth > 768) setActive(0);
</script>
